# Copy this file to .env and provide local, non-production values.
# Service-specific variables will be documented as each service is configured.

# Account Service (safe local placeholders only)
ACCOUNT_DB_URL=jdbc:postgresql://localhost:5432/ridelink_accounts
ACCOUNT_DB_USERNAME=replace_with_local_username
ACCOUNT_DB_PASSWORD=replace_with_local_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=3600000

# Driver and Vehicle Service (safe local placeholders only)
DRIVER_DB_URL=jdbc:postgresql://localhost:5432/ridelink_drivers
DRIVER_DB_USERNAME=replace_with_local_username
DRIVER_DB_PASSWORD=replace_with_local_password
ACCOUNT_SERVICE_URL=http://localhost:8081

# Fare and Payment Service (safe local placeholder only)
DB_PASSWORD=replace_with_local_password

# Ride Management Service (safe local placeholders only)
RIDE_DB_URL=jdbc:postgresql://localhost:5432/ridelink_rides
RIDE_DB_USERNAME=replace_with_local_username
RIDE_DB_PASSWORD=replace_with_local_password
DRIVER_SERVICE_URL=http://localhost:8082
FARE_PAYMENT_SERVICE_URL=http://localhost:8084
